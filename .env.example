# Helium Gateway Monitor - Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Solana RPC (required) ---
# A Helius or other RPC endpoint with DAS support for compressed NFTs.
# Free tier: https://www.helius.dev/
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
DAS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# --- Multi-Gateway API ---
# The helium-multi-gateway service runs on localhost:4468.
# The read key is auto-generated during install. Find it with:
#   sudo cat /etc/helium-multi-gateway/settings.toml
# Copy the value from the "read_api_key" line.
MULTI_GW_API=http://127.0.0.1:4468
MULTI_GW_READ_KEY=your-multi-gw-read-key

# --- Gateway Keys ---
# Directory containing .key files for each gateway (one per MAC address).
# This is created automatically by the helium-multi-gateway .deb install.
# Each gateway generates a .key file here on first connection.
GATEWAY_KEYS_DIR=/var/lib/helium-multi-gateway/keys

# --- Gateway Monitor (Python app) ---
# Base URL for the web UI (used in email notifications).
BASE_URL=https://your-domain.example.com

# Email notifications use AWS SES. You need:
#   1. An AWS account with SES enabled in your chosen region
#   2. A verified sender email/domain in SES
#   3. AWS credentials configured on the server (e.g. via IAM role, or
#      ~/.aws/credentials, or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars)
# See: https://docs.aws.amazon.com/ses/latest/dg/setting-up.html
SES_REGION=eu-west-2
SES_FROM_EMAIL=alerts@your-domain.example.com
ADMIN_EMAIL=your-email@example.com

# How often to evaluate gateway status for alerting (seconds). Must be smaller
# than OFFLINE_GRACE_MINUTES so the debounce can fire while a gateway is still
# inside the grace window. 5 minutes is a good default.
NOTIFICATION_CHECK_SECONDS=300

# A gateway must be CONTINUOUSLY offline for at least this many minutes before an
# offline email is sent. Short flaps (UDP keepalive timeouts, service restarts,
# brief network drops) recover inside this window and never notify. The matching
# "back online" email is only sent if an offline alert was sent first. Raise this
# if a flaky gateway is still too chatty; lower it to be alerted sooner.
OFFLINE_GRACE_MINUTES=30

# --- Stuck-dispatcher watchdog ---
# The UDP dispatcher in helium-multi-gateway can wedge: it keeps gateways marked
# "connected" but stops processing their packets (seen 2026-04-05; only a service
# restart recovers it). The monitor watches dispatcher.last_event_seconds_ago and
# auto-restarts the service when it stalls past the threshold while gateways are
# still connected. Requires a passwordless sudoers rule for the service user
# (setup.sh installs it: systemctl restart helium-multi-gateway.service).
DISPATCHER_STALE_THRESHOLD_SECONDS=1800   # 30 min with no dispatcher events = wedged
DISPATCHER_RESTART_ENABLED=1              # set to 0 to only email, never auto-restart
DISPATCHER_RESTART_COOLDOWN_MINUTES=30    # min gap between auto-restarts
DISPATCHER_RESTART_CONFIRM_POLLS=3        # consecutive stuck polls before acting
DISPATCHER_ALERT_COOLDOWN_MINUTES=60      # rate-limit for the email when restart is disabled
MULTI_GW_SERVICE=helium-multi-gateway.service

# --- Onboard Service (Node.js) ---
ONBOARD_PORT=3001
