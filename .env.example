# Helium Gateway Monitor - Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Solana RPC (required) ---
# A Helius or other RPC endpoint with DAS support for compressed NFTs.
# Free tier: https://www.helius.dev/
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
DAS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# --- Multi-Gateway API ---
# The helium-multi-gateway service API address and read key.
MULTI_GW_API=http://127.0.0.1:4468
MULTI_GW_READ_KEY=your-multi-gw-read-key

# --- Gateway Keys ---
# Directory containing .key files for each gateway (one per MAC address).
GATEWAY_KEYS_DIR=/var/lib/helium-multi-gateway/keys

# --- Gateway Monitor (Python app) ---
# Base URL for the web UI (used in email notifications).
BASE_URL=https://your-domain.example.com

# Email notifications use AWS SES. You need:
#   1. An AWS account with SES enabled in your chosen region
#   2. A verified sender email/domain in SES
#   3. AWS credentials configured on the server (e.g. via IAM role, or
#      ~/.aws/credentials, or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars)
# See: https://docs.aws.amazon.com/ses/latest/dg/setting-up.html
SES_REGION=eu-west-2
SES_FROM_EMAIL=alerts@your-domain.example.com
ADMIN_EMAIL=your-email@example.com

# How often to check for offline gateways (seconds).
NOTIFICATION_CHECK_SECONDS=3600
NOTIFICATION_COOLDOWN_HOURS=24

# --- Onboard Service (Node.js) ---
ONBOARD_PORT=3001
